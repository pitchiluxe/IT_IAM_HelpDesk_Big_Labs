{
  "version": 2,
  "public": true,
  "builds": [
    { "src": "api/contact.py", "use": "@vercel/python" },
    { "src": "landing.html", "use": "@vercel/static" },
    { "src": "static/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/", "dest": "/landing.html" },
    { "src": "/landing", "dest": "/landing.html" },
    { "src": "/static/(.*)", "dest": "/static/$1" }
  ]
}
